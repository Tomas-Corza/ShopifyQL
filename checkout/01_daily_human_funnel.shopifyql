FROM sessions
SHOW sessions, online_store_visitors, sessions_with_cart_additions, sessions_that_reached_checkout, sessions_that_completed_checkout, reached_checkout_rate, checkout_conversion_rate, conversion_rate
WHERE human_or_bot_session = 'human'
TIMESERIES day
SINCE 2026-10-14 UNTIL 2026-10-18
ORDER BY day ASC
